# Copy to server/.env (never commit .env). Every setting the API reads is listed here; the commented
# ones are optional or have a default. On Render the same names go in the dashboard (see DEPLOY.md).

PORT=8740
# Browser origins allowed to call the API, comma-separated. Production: the Vercel address.
CLIENT_ORIGIN=http://localhost:5210
# Set to 1 on Render (one proxy in front of the app), so rate limits see the real client IP.
TRUST_PROXY=0
# Web app address, used for links in emails and public pages. Production: the Vercel address.
APP_URL=http://localhost:5210
# Where this API is reachable from the internet (OAuth callbacks, webhook and SDK URLs use it).
# API_URL=https://<your-api>.onrender.com

# MongoDB Atlas connection string (database name: tessera).
# MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/tessera?retryWrites=true&w=majority
# Optional: DNS servers for the mongodb+srv lookup when Node cannot resolve it locally (not on Render).
# DNS_SERVERS=1.1.1.1,8.8.8.8
# Optional: time zone for "today", due dates and analytics days (default Asia/Kolkata).
# APP_TIMEZONE=Asia/Kolkata

# Sign-in tokens: a long random string (at least 32 characters). Changing it signs everyone out.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# BCRYPT_ROUNDS=12

# Email. Locally: Gmail SMTP with an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Tessera <you@gmail.com>
# On Render, whose free tier blocks SMTP: the relay on Vercel instead (client/api/send-mail.js).
# MAIL_RELAY_URL=https://<your-web-app>.vercel.app/api/send-mail
# MAIL_RELAY_SECRET=

# Push notifications: VAPID keys (generate once; `npx web-push generate-vapid-keys`).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# "Sign in with GitHub / Google" (free OAuth apps). Callbacks: <API_URL>/api/auth/oauth/github/callback
# and <API_URL>/api/auth/oauth/google/callback. GitHub allows one callback per app, so production
# needs its own GitHub OAuth app.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: Cloudflare Turnstile on the public bug-report page (free). Off unless both are set.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Optional limits (defaults shown): per IP per window, and file storage per project.
# LOGIN_RATE_LIMIT=10
# REGISTER_RATE_LIMIT=20
# EMAIL_RATE_LIMIT=5
# INVITE_RATE_LIMIT=30
# PORTAL_RATE_LIMIT=10
# INGEST_RATE_LIMIT=120
# ATTACHMENT_QUOTA_MB=100
